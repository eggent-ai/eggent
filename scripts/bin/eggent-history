#!/usr/bin/env node
/**
 * eggent-history - the versions Eggent keeps of a file, for the agent's shell
 * and the terminal panel.
 *
 *   eggent-history list <file>              every version, newest first
 *   eggent-history show <file> <n>          version n as it was, to standard output
 *   eggent-history text <file> <n>          version n as text (a document's text)
 *   eggent-history diff <file> <a> [<b>]    what changed from version a to b (default: the newest)
 *
 * It reads what the workspace keeps in data/versions and changes nothing. To go
 * back to a version, write its content into the file: what that replaces is
 * kept as a version too. The formats it reads are written by
 * src/lib/files/versions/store.ts, and the text of a document is read the way
 * src/lib/files/versions/text.ts reads it; a test holds the two together.
 */
"use strict";

const crypto = require("node:crypto");
const fs = require("node:fs");
const path = require("node:path");
const zlib = require("node:zlib");

function fail(message) {
  process.stderr.write(`eggent-history: ${message}\n`);
  process.exit(1);
}

function projectsDir() {
  if (process.env.EGGENT_PROJECTS_DIR) return path.resolve(process.env.EGGENT_PROJECTS_DIR);
  return path.resolve("/app/data/projects");
}

function versionsDir() {
  if (process.env.EGGENT_VERSIONS_DIR) return path.resolve(process.env.EGGENT_VERSIONS_DIR);
  return path.join(path.dirname(projectsDir()), "versions");
}

function realOr(value) {
  try {
    return fs.realpathSync(value);
  } catch {
    return value;
  }
}

function keyOf(file) {
  const root = realOr(projectsDir());
  const absolute = path.resolve(file);
  let parent;
  try {
    parent = fs.realpathSync(path.dirname(absolute));
  } catch {
    parent = path.dirname(absolute);
  }
  const key = path.relative(root, path.join(parent, path.basename(absolute))).split(path.sep).join("/");
  if (!key || key.startsWith("..") || path.isAbsolute(key)) fail(`${file} is not inside the projects folder (${root}), and only files there have a history.`);
  return key;
}

function sha256(value) {
  return crypto.createHash("sha256").update(value).digest("hex");
}

function readJournal(key) {
  const hash = sha256(key);
  const file = path.join(versionsDir(), "files", hash.slice(0, 2), `${hash}.json`);
  try {
    const journal = JSON.parse(fs.readFileSync(file, "utf8"));
    if (journal.key !== key || !Array.isArray(journal.versions)) return null;
    journal.versions.sort((a, b) => a.n - b.n);
    return journal;
  } catch {
    return null;
  }
}

function readObject(sha) {
  if (!sha) return null;
  try {
    return zlib.gunzipSync(fs.readFileSync(path.join(versionsDir(), "objects", sha.slice(0, 2), `${sha}.gz`)));
  } catch {
    return null;
  }
}

// What is read to tell whether a file still holds its newest version; a history keeps nothing larger.
const MAX_COMPARE_BYTES = 64 * 1024 * 1024;

/**
 * Whether the file holds its newest version now. The history can be behind
 * it: a change nobody has looked at yet, or one too large or unreadable to
 * keep. Its status is compared first, as the workspace does; the content only
 * when that moved.
 */
function fileState(key, journal, newest) {
  let stat;
  try {
    stat = fs.lstatSync(path.join(projectsDir(), ...key.split("/")));
  } catch {
    return newest.deleted ? "same" : "gone";
  }
  if (newest.deleted) return "back";
  if (!stat.isFile()) return "differs";
  const seen = journal.seen;
  if (seen && seen.mtimeMs === stat.mtimeMs && seen.ctimeMs === stat.ctimeMs && seen.size === stat.size) return "same";
  if (stat.size !== newest.size || stat.size > MAX_COMPARE_BYTES) return "differs";
  try {
    return sha256(fs.readFileSync(path.join(projectsDir(), ...key.split("/")))) === newest.sha ? "same" : "differs";
  } catch {
    return "differs";
  }
}

function author(entry) {
  if (entry.deleted) return "file deleted";
  const by = entry.by || {};
  switch (by.kind) {
    case "person": return "the user, in the editor";
    case "agent": return `${by.helper ? "a helper of the agent" : "the agent"}${by.chat ? ` (chat ${by.chat})` : ""}`;
    case "upload": return "uploaded";
    case "restore": return `restored from v${by.restoredFrom}`;
    case "earlier": return "as it was before the first change";
    default: return "changed outside (sync, a command or another program)";
  }
}

function size(bytes) {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}

// --- The text of a version: the same rules as text.ts. ----------------------

const TEXT_EXTENSIONS = new Set(("md markdown mdx txt text rst adoc asciidoc org tex bib csv tsv json jsonl ndjson yaml yml toml ini cfg conf properties " +
  "xml html htm xhtml svg css scss sass less js mjs cjs jsx ts mts cts tsx vue svelte astro py ipynb rb go rs java kt kts swift c h cc cpp hpp cs " +
  "php sh bash zsh fish ps1 sql r lua pl pm dart scala ex exs erl hrl hs ml mli clj edn graphql gql proto tf srt vtt").split(" "));

function extensionOf(name) {
  const base = path.basename(name).toLowerCase();
  const dot = base.lastIndexOf(".");
  return dot > 0 ? base.slice(dot + 1) : "";
}

function listZip(data) {
  let end = -1;
  for (let at = data.length - 22; at >= Math.max(0, data.length - 22 - 0xffff); at -= 1) {
    if (data.readUInt32LE(at) === 0x06054b50) {
      end = at;
      break;
    }
  }
  if (end < 0) throw new Error("not a zip");
  const total = data.readUInt16LE(end + 10);
  let at = data.readUInt32LE(end + 16);
  const entries = [];
  for (let index = 0; index < total; index += 1) {
    if (data.readUInt32LE(at) !== 0x02014b50) throw new Error("damaged zip");
    const method = data.readUInt16LE(at + 10);
    const compressedSize = data.readUInt32LE(at + 20);
    const nameLength = data.readUInt16LE(at + 28);
    const extraLength = data.readUInt16LE(at + 30);
    const commentLength = data.readUInt16LE(at + 32);
    const localOffset = data.readUInt32LE(at + 42);
    const name = data.subarray(at + 46, at + 46 + nameLength).toString("utf8").replace(/\\/g, "/");
    entries.push({ name, method, compressedSize, localOffset });
    at += 46 + nameLength + extraLength + commentLength;
  }
  return entries;
}

function readPart(data, entries, name) {
  const entry = entries.find((candidate) => candidate.name === name);
  if (!entry) return null;
  const header = entry.localOffset;
  const start = header + 30 + data.readUInt16LE(header + 26) + data.readUInt16LE(header + 28);
  const packed = data.subarray(start, start + entry.compressedSize);
  // Never past what a page of text could be: a part that inflates to more is not one.
  return (entry.method === 0 ? packed : zlib.inflateRawSync(packed, { maxOutputLength: 16 * 1024 * 1024 })).toString("utf8");
}

function safeCodePoint(code) {
  try {
    return Number.isFinite(code) && code > 0 ? String.fromCodePoint(code) : "";
  } catch {
    return "";
  }
}

function decodeXml(value) {
  if (!value.includes("&")) return value;
  return value.replace(/&(#x[0-9a-f]+|#\d+|lt|gt|quot|apos|amp);/gi, (whole, entity) => {
    const lower = entity.toLowerCase();
    if (lower.startsWith("#x")) return safeCodePoint(parseInt(lower.slice(2), 16));
    if (lower.startsWith("#")) return safeCodePoint(parseInt(lower.slice(1), 10));
    return { lt: "<", gt: ">", quot: '"', apos: "'", amp: "&" }[lower] ?? whole;
  });
}

// One pass, tag by tag: a document with tags that never close cannot make this slow.
function* xmlTokens(xml) {
  let at = 0;
  while (at < xml.length) {
    const lt = xml.indexOf("<", at);
    if (lt < 0) {
      yield { type: "text", text: xml.slice(at) };
      return;
    }
    if (lt > at) yield { type: "text", text: xml.slice(at, lt) };
    if (xml.startsWith("<!--", lt)) {
      const end = xml.indexOf("-->", lt + 4);
      at = end < 0 ? xml.length : end + 3;
      continue;
    }
    if (xml.startsWith("<![CDATA[", lt)) {
      const end = xml.indexOf("]]>", lt + 9);
      yield { type: "text", text: (end < 0 ? xml.slice(lt + 9) : xml.slice(lt + 9, end)).replace(/&/g, "&amp;") };
      at = end < 0 ? xml.length : end + 3;
      continue;
    }
    const gt = xml.indexOf(">", lt + 1);
    if (gt < 0) return;
    at = gt + 1;
    const inner = xml.slice(lt + 1, gt);
    if (inner.startsWith("?") || inner.startsWith("!")) continue;
    if (inner.startsWith("/")) {
      yield { type: "close", name: inner.slice(1).trim() };
      continue;
    }
    const selfClosing = inner.endsWith("/");
    const body = selfClosing ? inner.slice(0, -1) : inner;
    const space = body.search(/\s/);
    const name = space < 0 ? body : body.slice(0, space);
    yield { type: "open", name, attrs: space < 0 ? "" : body.slice(space + 1), selfClosing };
  }
}

function attribute(attrs, name) {
  const match = new RegExp(`(?:^|\\s)${name.replace(":", "\\:")}="([^"]*)"`).exec(attrs);
  return match ? decodeXml(match[1]) : undefined;
}

function wordText(xml) {
  const lines = [];
  const tables = [];
  const paragraphs = [];
  let inText = false;
  let deleted = 0;
  const emitParagraph = (text) => {
    const table = tables[tables.length - 1];
    if (table && table.cell) table.cell.push(text);
    else lines.push(text);
  };
  const append = (text) => {
    if (paragraphs.length > 0 && deleted === 0) paragraphs[paragraphs.length - 1] += text;
  };
  for (const token of xmlTokens(xml)) {
    if (token.type === "text") {
      if (inText) append(decodeXml(token.text));
      continue;
    }
    const name = token.name;
    if (token.type === "open") {
      if (name === "w:del") {
        if (!token.selfClosing) deleted += 1;
      } else if (name === "w:p") {
        if (token.selfClosing) emitParagraph("");
        else paragraphs.push("");
      } else if (name === "w:t") {
        inText = !token.selfClosing;
      } else if (name === "w:tab") {
        append("\t");
      } else if (name === "w:br" || name === "w:cr") {
        append("\n");
      } else if (name === "w:tbl" && !token.selfClosing) {
        tables.push({ row: null, cell: null });
      } else if (name === "w:tr" && !token.selfClosing) {
        const table = tables[tables.length - 1];
        if (table) table.row = [];
      } else if (name === "w:tc" && !token.selfClosing) {
        const table = tables[tables.length - 1];
        if (table) table.cell = [];
      }
      continue;
    }
    if (name === "w:del") deleted = Math.max(0, deleted - 1);
    else if (name === "w:t") inText = false;
    else if (name === "w:p") {
      const text = paragraphs.pop();
      if (text !== undefined) emitParagraph(text);
    } else if (name === "w:tc") {
      const table = tables[tables.length - 1];
      if (table && table.cell && table.row) table.row.push(table.cell.join(" ").trim());
      if (table) table.cell = null;
    } else if (name === "w:tr") {
      const table = tables[tables.length - 1];
      if (table && table.row && table.row.some(Boolean)) {
        const line = table.row.join(" | ");
        const outer = tables[tables.length - 2];
        if (outer && outer.cell) outer.cell.push(line);
        else lines.push(line);
      }
      if (table) table.row = null;
    } else if (name === "w:tbl") {
      tables.pop();
    }
  }
  return lines.join("\n");
}

function openDocumentText(xml) {
  const lines = [];
  let paragraph = null;
  let depth = 0;
  for (const token of xmlTokens(xml)) {
    if (token.type === "text") {
      if (paragraph !== null) paragraph += decodeXml(token.text);
      continue;
    }
    if (token.type === "open") {
      if (token.name === "text:p" || token.name === "text:h") {
        if (token.selfClosing) {
          if (paragraph === null) lines.push("");
        } else if (paragraph === null) {
          paragraph = "";
          depth = 1;
        } else {
          depth += 1;
        }
      } else if (paragraph !== null) {
        if (token.name === "text:tab") paragraph += "\t";
        else if (token.name === "text:line-break") paragraph += "\n";
        else if (token.name === "text:s") paragraph += " ";
      }
      continue;
    }
    if ((token.name === "text:p" || token.name === "text:h") && paragraph !== null) {
      depth -= 1;
      if (depth === 0) {
        lines.push(paragraph);
        paragraph = null;
      }
    }
  }
  return lines.join("\n");
}

function slideText(xml) {
  const lines = [];
  let paragraph = null;
  let inText = false;
  for (const token of xmlTokens(xml)) {
    if (token.type === "text") {
      if (inText && paragraph !== null) paragraph += decodeXml(token.text);
      continue;
    }
    if (token.type === "open") {
      if (token.name === "a:p") paragraph = token.selfClosing ? null : "";
      else if (token.name === "a:t") inText = !token.selfClosing;
      else if (token.name === "a:tab" && paragraph !== null) paragraph += "\t";
      else if (token.name === "a:br" && paragraph !== null) paragraph += "\n";
      continue;
    }
    if (token.name === "a:t") inText = false;
    else if (token.name === "a:p") {
      if (paragraph !== null && paragraph.trim()) lines.push(paragraph);
      paragraph = null;
    }
  }
  return lines;
}

function numbered(entries, pattern) {
  const number = (name) => Number((/(\d+)\.xml$/.exec(name) || [])[1] || 0);
  return entries.map((entry) => entry.name).filter((name) => pattern.test(name)).sort((a, b) => number(a) - number(b));
}

function sharedStrings(xml) {
  const strings = [];
  let current = null;
  let inText = false;
  let phonetic = 0;
  for (const token of xmlTokens(xml)) {
    if (token.type === "text") {
      if (inText && phonetic === 0 && current !== null) current += decodeXml(token.text);
      continue;
    }
    if (token.type === "open") {
      if (token.name === "si") {
        if (token.selfClosing) strings.push("");
        else current = "";
      } else if (token.name === "t") inText = !token.selfClosing;
      else if (token.name === "rPh" && !token.selfClosing) phonetic += 1;
      continue;
    }
    if (token.name === "t") inText = false;
    else if (token.name === "rPh") phonetic = Math.max(0, phonetic - 1);
    else if (token.name === "si") {
      if (current !== null) strings.push(current);
      current = null;
    }
  }
  return strings;
}

function sheetLines(xml, shared) {
  const lines = [];
  let row = null;
  let cell = null;
  let reading = null;
  const finishCell = () => {
    if (!row || !cell) return;
    let value = "";
    if (cell.type === "s") value = cell.value ? shared[Number(cell.value)] ?? "" : "";
    else if (cell.type === "inlineStr") value = cell.inline;
    else if (cell.type === "b") value = cell.value === "1" ? "TRUE" : cell.value === "0" ? "FALSE" : "";
    else value = cell.value;
    if (cell.formula) value = value ? `${value} (=${cell.formula})` : `=${cell.formula}`;
    if (value !== "") row.cells.push(`${cell.column}: ${value.replace(/\n/g, " ")}`);
    cell = null;
  };
  for (const token of xmlTokens(xml)) {
    if (token.type === "text") {
      if (!cell || !reading) continue;
      const text = decodeXml(token.text);
      if (reading === "v") cell.value += text;
      else if (reading === "f") cell.formula += text;
      else cell.inline += text;
      continue;
    }
    if (token.type === "open") {
      if (token.name === "row") {
        row = { number: attribute(token.attrs, "r") ?? "", cells: [] };
        if (token.selfClosing) row = null;
      } else if (token.name === "c") {
        const reference = attribute(token.attrs, "r") ?? "";
        cell = { column: (/^[A-Z]+/.exec(reference) || [""])[0], type: attribute(token.attrs, "t"), value: "", formula: "", inline: "" };
        if (token.selfClosing) finishCell();
      } else if (cell && (token.name === "v" || token.name === "f" || token.name === "t")) {
        reading = token.selfClosing ? null : token.name;
      }
      continue;
    }
    if (token.name === "v" || token.name === "f" || token.name === "t") reading = null;
    else if (token.name === "c") finishCell();
    else if (token.name === "row") {
      if (row && row.cells.length > 0) lines.push(`${row.number}. ${row.cells.join(" | ")}`);
      row = null;
    }
  }
  return lines;
}

function workbookText(data) {
  const entries = listZip(data);
  const sharedXml = readPart(data, entries, "xl/sharedStrings.xml");
  const shared = sharedXml ? sharedStrings(sharedXml) : [];
  const targets = new Map();
  for (const token of xmlTokens(readPart(data, entries, "xl/_rels/workbook.xml.rels") || "")) {
    if (token.type !== "open" || token.name !== "Relationship") continue;
    const id = attribute(token.attrs, "Id");
    const target = attribute(token.attrs, "Target");
    if (id && target) targets.set(id, target.replace(/^\/?(xl\/)?/, "xl/"));
  }
  const names = new Map();
  const order = [];
  for (const token of xmlTokens(readPart(data, entries, "xl/workbook.xml") || "")) {
    if (token.type !== "open" || token.name !== "sheet") continue;
    const id = attribute(token.attrs, "r:id");
    const target = id ? targets.get(id) : undefined;
    if (target) {
      names.set(target, attribute(token.attrs, "name") ?? "");
      order.push(target);
    }
  }
  const sheets = order.length > 0 ? order : numbered(entries, /^xl\/worksheets\/sheet\d+\.xml$/);
  if (sheets.length === 0) return null;
  const lines = [];
  sheets.forEach((part, index) => {
    const xml = readPart(data, entries, part);
    if (xml === null) return;
    if (lines.length > 0) lines.push("");
    lines.push(`## ${names.get(part) || `Sheet${index + 1}`}`);
    lines.push(...sheetLines(xml, shared));
  });
  return lines.join("\n");
}

function presentationText(data) {
  const entries = listZip(data);
  const slides = numbered(entries, /^ppt\/slides\/slide\d+\.xml$/);
  if (slides.length === 0) return null;
  const lines = [];
  slides.forEach((name, index) => {
    const xml = readPart(data, entries, name);
    if (xml === null) return;
    if (lines.length > 0) lines.push("");
    lines.push(`## Slide ${index + 1}`);
    lines.push(...slideText(xml));
  });
  return lines.join("\n");
}

function textOf(name, content) {
  const extension = extensionOf(name);
  if (TEXT_EXTENSIONS.has(extension) || !extension) return content.toString("utf8").replace(/^﻿/, "");
  try {
    if (extension === "docx") {
      const xml = readPart(content, listZip(content), "word/document.xml");
      return xml === null ? null : wordText(xml);
    }
    if (extension === "odt") {
      const xml = readPart(content, listZip(content), "content.xml");
      return xml === null ? null : openDocumentText(xml);
    }
    if (extension === "xlsx") return workbookText(content);
    if (extension === "pptx") return presentationText(content);
    return null;
  } catch {
    return null;
  }
}

// --- Commands. ---------------------------------------------------------------

function entryOf(journal, value) {
  const n = Number(value);
  if (!Number.isInteger(n) || n < 1) fail(`"${value}" is not a version number (see: eggent-history list <file>).`);
  const entry = journal.versions.find((candidate) => candidate.n === n);
  if (!entry) fail(`there is no version ${n} of this file (see: eggent-history list <file>).`);
  return entry;
}

function main(argv) {
  const [command, file, ...rest] = argv;
  if (!command || command === "help" || command === "--help" || command === "-h") {
    process.stdout.write([
      "eggent-history list <file>              every version, newest first",
      "eggent-history show <file> <n>          version n as it was, to standard output",
      "eggent-history text <file> <n>          version n as text (for a document, the text inside it)",
      "eggent-history diff <file> <a> [<b>]    what changed from version a to version b (default: the newest)",
      "",
      "To go back to a version, write its content into the file, e.g.",
      "  eggent-history show notes.md 3 > notes.md",
      "What it replaces stays in the history.",
      "",
    ].join("\n"));
    return;
  }
  if (!file) fail("name a file.");
  const key = keyOf(file);
  const journal = readJournal(key);
  if (!journal || journal.versions.length === 0) {
    if (command === "list") {
      process.stdout.write(`${key} has no history yet: versions are kept from its first change on.\n`);
      return;
    }
    fail(`${key} has no history yet.`);
  }
  const name = path.basename(key);

  if (command === "list") {
    const newest = journal.versions[journal.versions.length - 1];
    const state = fileState(key, journal, newest);
    process.stdout.write(`History of ${key} (${journal.versions.length} versions, newest first):\n`);
    for (const entry of [...journal.versions].reverse()) {
      const when = new Date(entry.at).toISOString().replace("T", " ").slice(0, 16) + " UTC";
      const stats = typeof entry.added === "number" && typeof entry.removed === "number" ? `  +${entry.added} -${entry.removed}` : "";
      const current = entry === newest && !entry.deleted && state === "same" ? "  (current)" : "";
      process.stdout.write(`v${entry.n}  ${when}  ${author(entry)}  ${size(entry.size)}${stats}${current}\n`);
    }
    if (state === "differs") process.stdout.write(`The file has changed since v${newest.n} and that change is not in its history (too large or unreadable to keep, or not looked at yet): what it holds now is in the file itself.\n`);
    if (state === "gone") process.stdout.write(`The file is not there any more; v${newest.n} is the last version kept.\n`);
    if (state === "back") process.stdout.write(`The file is there again, and what it holds now is not in its history yet.\n`);
    return;
  }

  if (command === "show") {
    const entry = entryOf(journal, rest[0]);
    if (entry.deleted) fail(`version ${entry.n} records the file's deletion and holds nothing.`);
    const content = readObject(entry.sha);
    if (!content) fail(`version ${entry.n} is not available any more.`);
    process.stdout.write(content);
    return;
  }

  if (command === "text") {
    const entry = entryOf(journal, rest[0]);
    if (entry.deleted) fail(`version ${entry.n} records the file's deletion and holds nothing.`);
    const content = readObject(entry.sha);
    if (!content) fail(`version ${entry.n} is not available any more.`);
    const text = textOf(name, content);
    if (text === null) fail(`the text of this kind of file cannot be read here; use show to get the file.`);
    process.stdout.write(text.endsWith("\n") ? text : `${text}\n`);
    return;
  }

  if (command === "diff") {
    const older = entryOf(journal, rest[0]);
    const newer = rest[1] ? entryOf(journal, rest[1]) : journal.versions[journal.versions.length - 1];
    const read = (entry) => {
      if (entry.deleted) return "";
      const content = readObject(entry.sha);
      if (!content) fail(`version ${entry.n} is not available any more.`);
      const text = textOf(name, content);
      if (text === null) fail("versions of this kind of file cannot be compared as text; use show to get both.");
      return text;
    };
    const { createTwoFilesPatch, structuredPatch } = require("diff");
    const olderText = read(older);
    const newerText = read(newer);
    if (structuredPatch("a", "b", olderText, newerText, "", "", { context: 0 }).hunks.length === 0) {
      process.stdout.write(`No difference in the text between v${older.n} and v${newer.n}.\n`);
      return;
    }
    process.stdout.write(createTwoFilesPatch(`${key} v${older.n}`, `${key} v${newer.n}`, olderText, newerText, "", "", { context: 3 }));
    return;
  }

  fail(`unknown command "${command}" (try: eggent-history help).`);
}

main(process.argv.slice(2));
